    {
      "parameters": {
        "functionCode": "const content = ($json.data || '').replace(/[\\x00-\\x1F]/g, (c) => {\n  if (c === '\\n' || c === '\\r' || c === '\\t') return c;\n  return ' ';\n});\n\nreturn [{\n  model: 'gpt-4o-mini',\n  messages: [\n    {\n      role: 'system',\n      content: 'You are an expert SQL code reviewer. Provide a structured review in this format:\\n\\n| Issue Type | Line(s) | Severity | Description | Recommendation |\\n|------------|---------|----------|-------------|----------------|\\n\\nThen add \"Optimized Code\" section. Severity: Critical/High/Medium/Low/Info.'\n    },\n    {\n      role: 'user',\n      content: content\n    }\n  ],\n  stream: false\n}];"
      },
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
